---
import Base from '../layouts/Base.astro';
import Formules from '../components/Formules.astro';
import Deroulement from '../components/Deroulement.astro';
import Exemples from '../components/Exemples.astro';
import Todo from '../components/Todo.astro';
import { formules, comprisOffre, socleBot, conditions, prestations, contact, paiementModule, formuleRecommandee, optionsUnite, besoinRegulier, engagementTotal, finEngagement, auDelaRecommandee, euros, moisPayes } from '../data/offre';

const { acomptePourcent, etalementMoisMax } = paiementModule;
const partenaire = formules.find((f) => f.id === 'partenaire')!;
---
<Base
  titre="L'offre"
  description={`Création offerte de votre outil ou de votre site, puis un abonnement qui couvre hébergement, maintenance et modifications. Trois formules de ${euros(formules[0].prixMensuel)} à ${euros(formules[2].prixMensuel)} HT par mois, pour votre outil, votre site ou votre bot Discord.`}
>
  <div class="grille bloc offre-tete">
    <p class="etiquette plein">Alexis Cabillic · développeur web freelance à Pau</p>
    <h1 class="affiche plein">L'offre</h1>
    <p class="chapeau">
      Planning, prise de rendez-vous, suivi de clients, application pour votre équipe, votre
      site ou votre bot Discord&nbsp;: je crée l'outil, puis un abonnement couvre
      l'hébergement, la maintenance et les modifications, sans rien à gérer de votre côté.
      <span class="cle">La création est offerte</span>, avec la première version d'un outil
      simple&nbsp;: seule la mise en service est facturée, {euros(conditions.miseEnService)}&nbsp;HT
      une fois.
    </p>
  </div>

  <section class="grille bloc" aria-labelledby="formules">
    <h2 id="formules" class="intertitre">Trois formules</h2>
    <p>Pour votre outil, votre site ou votre bot Discord.</p>
    <Formules variante="offre" />
    <p class="plein">{besoinRegulier}</p>
    <div class="engagement plein">
      <p><strong>{engagementTotal}</strong></p>
      <p>{finEngagement}</p>
    </div>
    {formuleRecommandee.pourQuiDetail && (
      <p class="pour-qui plein">
        <strong>La formule {formuleRecommandee.nom}, pour qui&nbsp;?</strong>
        {formuleRecommandee.pourQuiDetail}
      </p>
    )}
    <p class="appels plein">
      <a class="appel" href="#exemple-planning">Voir un exemple d'outil</a>
    </p>
  </section>

  <section class="grille bloc" aria-labelledby="compris">
    <h2 id="compris" class="intertitre">Compris dans toutes les formules</h2>
    <ul class="compris plein" role="list">
      {comprisOffre.map((element) => <li>{element.replace(/^./, (c) => c.toUpperCase())}</li>)}
    </ul>
  </section>

  <section class="grille bloc" aria-labelledby="deroulement">
    <h2 id="deroulement" class="intertitre">Comment ça se passe</h2>
    <Deroulement />
  </section>

  <section class="grille bloc" aria-labelledby="pourquoi">
    <h2 id="pourquoi" class="intertitre">Pourquoi la formule {formuleRecommandee.nom}&nbsp;?</h2>
    <ul class="alternatives plein" role="list">
      <li>
        <h3>Logiciel standard</h3>
        <ul>
          <li>Prêt tout de suite, mais c'est à vous de vous adapter à lui.</li>
          <li>Pas relié à vos autres outils ni à votre site.</li>
        </ul>
      </li>
      <li>
        <h3>Gros devis sur mesure</h3>
        <ul>
          <li>Il faut tout prévoir à l'avance et payer d'un coup.</li>
          <li>Ce qu'on n'a pas prévu coûte un nouveau devis.</li>
        </ul>
      </li>
      <li class="alternative-recommandee">
        <h3>Formule {formuleRecommandee.nom}</h3>
        <ul>
          <li>Une première version rapide, puis des ajustements chaque mois.</li>
          <li>Un seul interlocuteur.</li>
          <li>Site et outil reliés&nbsp;: un rendez-vous pris sur le site arrive dans votre planning.</li>
        </ul>
      </li>
    </ul>
  </section>

  <section class="grille bloc" aria-labelledby="exemples">
    <h2 id="exemples" class="intertitre">Exemples d'outils</h2>
    <p class="plein">Des exemples de ce que je peux créer pour vous, à partir de votre besoin.</p>
    <Exemples />
  </section>

  <section class="grille bloc" aria-labelledby="sur-mesure">
    <h2 id="sur-mesure" class="intertitre">Sur mesure</h2>
    <ul class="sur-mesure plein" role="list">
      <li>
        <h3 id="modules">Outils sur mesure</h3>
        <p>Un outil pensé pour votre métier, relié à votre site s'il y en a un (<a href="#exemples">exemples</a>).</p>
        <p>
          Un outil simple se construit avec la
          <a href={`#formule-${formuleRecommandee.id}`}>formule {formuleRecommandee.nom}</a>.
          {auDelaRecommandee}
        </p>
      </li>
      <li>
        <h3 id="bots">Bots Discord</h3>
        <p>
          Même principe que les outils et les sites&nbsp;: mise en service, puis la formule de votre choix.
          Compris&nbsp;: un bot à votre nom ({socleBot.join(', ')}), configuré pour votre
          serveur, avec son tableau de bord sur votrebot.cabalex.dev ou sur votre domaine.
        </p>
        <p>
          Exemples&nbsp;: <a href="/dofintendant">DofIntendant</a>, public et gratuit
          (<a href="https://dofintendant.cabalex.dev/inviter">essayez-le</a>),
          <a href="/bot-legendes">Bot Légendes</a> et <a href="/patchoumio">Patchoumio</a>.
        </p>
      </li>
      <li>
        <h3>Applications métier</h3>
        <p class="formule-prix">
          <span class="etiquette">à partir de</span>
          <span class="formule-montant">{euros(prestations.surMesure.aPartirDe)}</span>
          <span class="etiquette">HT, sur devis</span>
        </p>
        <p>
          Quand il faut un outil plus complet. Exemple en production&nbsp;:
          <a href="/plumes-jumelles">Plumes Jumelles</a>, avec abonnements, boutique et
          gestion des commandes.
        </p>
      </li>
    </ul>
    <p class="appels plein"><a class="appel" href={contact.mailto}>Parlons de votre besoin</a></p>
  </section>

  <section class="grille bloc" aria-labelledby="faq">
    <h2 id="faq" class="intertitre">Questions fréquentes</h2>
    <div class="faq">
      <details>
        <summary>Pourquoi la création est-elle offerte&nbsp;?</summary>
        <p>
          Parce que je me rémunère sur l'abonnement&nbsp;: le temps passé à créer votre outil ou votre site est
          couvert par les {conditions.engagementMois} mois d'engagement. Vous n'avez pas de grosse
          somme à avancer au départ. Seuls des frais de mise en service sont facturés&nbsp;:
          {euros(conditions.miseEnService)} HT, une seule fois.
        </p>
      </details>
      <details>
        <summary>Comment se passe le paiement&nbsp;?</summary>
        <p>
          Sur facture&nbsp;: pas de paiement en ligne. Vous payez chaque mois, ou d'avance pour
          toute la durée choisie. Payés d'avance, {conditions.engagementMois}&nbsp;mois n'en
          coûtent que {moisPayes(12)}&nbsp;: un mois offert. Pour 6 ou 3&nbsp;mois d'avance, c'est
          le montant total, sans remise. La mise en service, {euros(conditions.miseEnService)}&nbsp;HT,
          est facturée une seule fois, quelle que soit la formule.
        </p>
      </details>
      <details>
        <summary>Que se passe-t-il à la fin de l'engagement&nbsp;?</summary>
        <p>
          {engagementTotal} {finEngagement} Au-delà de {conditions.engagementMois}&nbsp;mois
          cumulés, l'{formules[0].nom} est sans engagement&nbsp;: vous l'arrêtez avec un mois de
          préavis.
        </p>
        <p>
          Après {conditions.engagementMois}&nbsp;mois d'abonnement cumulés, toutes formules
          confondues, vous recevez une copie complète et utilisable de votre site ; le nom de
          domaine et les contenus vous appartiennent déjà.
        </p>
      </details>
      <details>
        <summary>Et si je veux partir&nbsp;?</summary>
        <p>
          Pendant les {conditions.engagementMois} premiers mois, les mois restants jusqu'à la fin
          de l'engagement sont dus. Ensuite, vous pouvez partir avec un mois de préavis. Je vous
          remets une copie complète du site, l'export de vos contenus et les accès nécessaires.
          Votre nom de domaine est transféré vers le prestataire de votre choix, et je vous aide
          à récupérer vos e-mails. Ces remises se font dans les 30&nbsp;jours suivant la fin du
          contrat, sans frais.
        </p>
        <Todo note="Lien vers les conditions générales de vente (en cours de rédaction)." />
        <Todo note="CGV, clause de propriété : le client reçoit une copie complète et utilisable de son site ; les briques techniques communes à mes sites restent ma propriété (licence d'utilisation, pas de cession exclusive)." />
      </details>
      <details>
        <summary>Qu'est-ce qu'une évolution&nbsp;?</summary>
        <p>
          Une amélioration ciblée, qui se fait en une session de travail&nbsp;: ajouter une page
          ou une section, un champ dans un formulaire, un export, une fonction simple dans
          l'outil ou le bot. Les évolutions ne se cumulent pas d'un mois sur l'autre. En
          {formules.find((f) => f.id === optionsUnite.formule)!.nom}, vous pouvez commander une
          évolution à l'unité&nbsp;: {euros(optionsUnite.evolution.prix)}&nbsp;HT. Si votre
          besoin change, on ajuste au point mensuel ; un besoin plus important fait l'objet d'un
          devis, payable comptant ou étalé, ou d'un passage à la formule {partenaire.nom}.
        </p>
      </details>
      <details>
        <summary>Mon outil fonctionne-t-il sur téléphone&nbsp;?</summary>
        <p>
          Oui. C'est une application web installable (PWA)&nbsp;: elle s'ouvre dans le
          navigateur, sur ordinateur comme sur téléphone, et s'ajoute à l'écran d'accueil comme
          une application, sans passer par l'App Store ni Google Play. Les mises à jour arrivent
          d'elles-mêmes. Sur iPhone, l'ajout passe par le menu Partager, «&nbsp;Sur l'écran
          d'accueil&nbsp;».
        </p>
      </details>
      <details>
        <summary>Je ne sais pas exactement ce qu'il me faut.</summary>
        <p>
          C'est normal. On part du problème, je livre une première version simple, et on l'affine
          à l'usage.
        </p>
      </details>
      <details>
        <summary>Est-ce rentable pour une petite entreprise&nbsp;?</summary>
        <p>
          Par exemple, un outil qui vous fait gagner quelques heures par mois, ou qui évite des
          rendez-vous manqués, peut vite se rembourser. Votre site et son hébergement sont déjà compris dans la
          formule {formuleRecommandee.nom}.
        </p>
      </details>
      <details>
        <summary>Puis-je étaler le paiement d'un outil sur devis&nbsp;?</summary>
        <p>
          Oui. Chaque outil plus complet est sur devis, et vous choisissez&nbsp;: paiement comptant à la
          livraison, ou paiement étalé, ajouté à votre abonnement mensuel. Dans ce cas, vous
          versez {acomptePourcent}&nbsp;% d'acompte à la commande, puis le reste est réparti sur
          {etalementMoisMax}&nbsp;mois au plus. Si vous partez avant la fin de l'étalement, le
          reste est dû.
        </p>
      </details>
    </div>
  </section>

  <section class="grille bloc" aria-labelledby="contact">
    <h2 id="contact" class="intertitre">Parlons de votre besoin</h2>
    <div class="prose">
      <p class="chapeau">
        Dites-moi en quelques lignes ce que vous faites et ce qui vous fait perdre du temps. On
        en parle, gratuitement et sans engagement.
      </p>
      <p class="appels">
        <a class="appel" href={contact.mailto}>Écrire à {contact.email}</a>
      </p>
      <p class="etiquette">{contact.zone}</p>
    </div>
  </section>
</Base>
