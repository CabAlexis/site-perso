---
import Base from '../layouts/Base.astro';
---
<Base titre="Page introuvable" description="Cette page n'existe pas sur cabalex.dev." noindex>
  <div class="grille bloc">
    <h1 class="affiche plein">404</h1>
    <div class="prose">
      <p class="chapeau">Cette page n'existe pas, ou plus.</p>
      <p>L'<a href="/">accueil</a> présente ce que je fais, et l'<a href="/offre">offre</a> le détail des formules.</p>
    </div>
  </div>
</Base>
