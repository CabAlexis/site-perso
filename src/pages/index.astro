---
import Base from '../layouts/Base.astro';
import Vignette from '../components/Vignette.astro';
import SuiteAccueil from '../components/SuiteAccueil.astro';
import { projets } from '../data/projets';
import { coupes } from '../data/coupes';
import { formules, euros } from '../data/offre';
---
<Base
  titre="Alexis Cabillic"
  description={`Développeur web freelance à Pau. Création de votre site, mise en ligne, puis hébergement, maintenance et modifications. Dès ${euros(formules[0].prixMensuel)} HT par mois.`}
>
  <header class="tete">
    <div class="tete-plan" aria-hidden="true">
      {projets.map((p) => <Vignette id={`plan-${p.slug}`} coupe={coupes[p.slug]} />)}
    </div>
    <div class="grille tete-texte">
      <p class="etiquette plein">Alexis Cabillic · développeur web freelance à Pau</p>
      <h1 class="tete-titre plein">
        <span class="tete-l tete-l1">De la première idée</span>
        <span class="tete-l tete-l2">à la mise en ligne,</span>
        <span class="tete-l tete-l3">et tout ce qui suit.</span>
      </h1>
      <div class="tete-bas plein">
        <p class="chapeau">
          Des sites et des applications web pour les artisans, les indépendants et les PME,
          conçus, mis en ligne puis entretenus. Un seul interlocuteur, du premier échange au
          suivi.
        </p>
        <p class="etiquette">
          En ligne : un site vitrine pour une agence immobilière (démo), la boutique et
          l'abonnement de Plumes Jumelles.<br />
          En service : trois bots Discord, dont DofIntendant, public et gratuit.
        </p>
      </div>
    </div>
  </header>

  <SuiteAccueil />
</Base>
