---
import Base from '../layouts/Base.astro';
import Vignette from '../components/Vignette.astro';
import SuiteAccueil from '../components/SuiteAccueil.astro';
import { projets } from '../data/projets';
import { coupes } from '../data/coupes';
import { formules, formuleRecommandee, euros } from '../data/offre';
---
<Base
  titre="Alexis Cabillic"
  description={`Développeur freelance à Pau. Planning, prise de rendez-vous, suivi de clients ou site : l’outil qu’il vous faut, mis en ligne puis hébergé et maintenu, dès ${euros(formules[0].prixMensuel)} HT par mois.`}
>
  <header class="tete">
    <div class="tete-plan" aria-hidden="true">
      {projets.map((p) => <Vignette id={`plan-${p.slug}`} coupe={coupes[p.slug]} />)}
    </div>
    <div class="grille tete-texte">
      <p class="etiquette plein">Alexis Cabillic · développeur freelance à Pau</p>
      <h1 class="tete-titre plein">
        <span class="tete-l tete-l1">D'un besoin,</span>
        <span class="tete-l tete-l3">je crée un outil.</span>
      </h1>
      <div class="tete-bas plein">
        <p class="chapeau">
          Un planning, la prise de rendez-vous, le suivi de vos clients, une application pour
          votre équipe sur le terrain, ou votre site&nbsp;: je crée l'outil qui vous fait gagner
          du temps et je le mets en ligne. Avec la formule {formuleRecommandee.nom}, on l'améliore
          ensemble chaque mois. Pour les artisans, les indépendants et les PME.
        </p>
        <p class="etiquette">
          En ligne : un site vitrine pour une agence immobilière (démo), la boutique et
          l'abonnement de Plumes Jumelles.<br />
          En service : trois bots Discord, dont DofIntendant, public et gratuit.
        </p>
      </div>
    </div>
  </header>

  <SuiteAccueil />
</Base>
