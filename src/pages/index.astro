---
import Base from '../layouts/Base.astro';
import Vignette from '../components/Vignette.astro';
import SuiteAccueil from '../components/SuiteAccueil.astro';
import { projets } from '../data/projets';
import { coupes } from '../data/coupes';
---
<Base
  titre="Alexis Cabillic"
  description="Développeur web à Pau. Quatre projets décrits en détail : ce qui a été choisi, ce qui a été refusé, et ce que ça a coûté."
>
  <header class="tete">
    <div class="tete-plan" aria-hidden="true">
      {projets.map((p) => <Vignette id={`plan-${p.slug}`} coupe={coupes[p.slug]} />)}
    </div>
    <div class="grille tete-texte">
      <p class="etiquette plein">Alexis Cabillic · développeur web freelance à Pau</p>
      <h1 class="tete-titre plein">
        <span class="tete-l tete-l1">De la base de données</span>
        <span class="tete-l tete-l2">au serveur</span>
        <span class="tete-l tete-l3">qui tourne.</span>
      </h1>
      <div class="tete-bas plein">
        <p class="chapeau">
          Je conçois et je construis des applications web, le plus souvent en Laravel et Vue,
          et je les mets en production moi-même. Chaque projet ci-dessous dit ce qui a été
          choisi, ce qui a été refusé, et ce que ça a coûté.
        </p>
        <p class="etiquette">
          Quatre projets : un en production, un fonctionnel, un en service, un à l'arrêt.
          Dépôts privés : les chiffres cités sont déclarés et datés.
        </p>
      </div>
    </div>
  </header>

  <SuiteAccueil />
</Base>
