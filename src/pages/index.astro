---
import Base from '../layouts/Base.astro';
import Vignette from '../components/Vignette.astro';
import SuiteAccueil from '../components/SuiteAccueil.astro';
import { projets } from '../data/projets';
import { coupes } from '../data/coupes';
---
<Base
  titre="Alexis Cabillic"
  description="Développeur web freelance à Pau. Je crée votre site, je le mets en ligne, puis je m'en occupe : hébergement, maintenance, modifications. Dès 39 € HT par mois."
>
  <header class="tete">
    <div class="tete-plan" aria-hidden="true">
      {projets.map((p) => <Vignette id={`plan-${p.slug}`} coupe={coupes[p.slug]} />)}
    </div>
    <div class="grille tete-texte">
      <p class="etiquette plein">Alexis Cabillic · développeur web freelance à Pau</p>
      <h1 class="tete-titre plein">
        <span class="tete-l tete-l1">De la première idée</span>
        <span class="tete-l tete-l2">à la mise en ligne,</span>
        <span class="tete-l tete-l3">et pour la suite.</span>
      </h1>
      <div class="tete-bas plein">
        <p class="chapeau">
          Je crée des sites et des applications web pour les artisans, les indépendants et les
          PME. Je les mets en ligne, puis je m'en occupe. Vous avez un seul interlocuteur, du
          premier échange au suivi.
        </p>
        <p class="etiquette">
          En ligne : la boutique et l'abonnement de Plumes Jumelles. En service : deux bots
          Discord, pour une alliance Dofus et pour le serveur Warframe d'un youtubeur.
        </p>
      </div>
    </div>
  </header>

  <SuiteAccueil />
</Base>
