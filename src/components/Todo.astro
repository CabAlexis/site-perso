---
/*
 * Trou signalé. Émet le marqueur <!-- TODO(cabalex): ... --> exigé par le
 * garde-fou de build, et l'affiche dans la page pour qu'il se voie en relecture.
 *
 * En prépublication (src/data/publication.json), il ne rend rien : le site
 * peut partir en ligne avec ses trous masqués, et le garde-fou les liste en
 * avertissement au lieu de refuser le build. Les pages masquent aussi ce qui
 * n'aurait pas de sens sans l'information (ligne Téléphone, section CGV…).
 */
import { prepublication } from '../data/publication.json';

interface Props {
  note: string;
  enLigne?: boolean;
}
const { note, enLigne = false } = Astro.props;
const Balise = enLigne ? 'span' : 'p';
const commentaire = `<!-- TODO(cabalex): ${note.replaceAll('--', '—')} -->`;
---
{!prepublication && <><Fragment set:html={commentaire} /><Balise class="trou">{note}</Balise></>}
