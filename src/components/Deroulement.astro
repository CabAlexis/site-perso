---
/*
 * « Comment ça se passe » : les quatre étapes, du premier échange au suivi,
 * chacune en une phrase. Le résumé peut porter un mot clé (.cle).
 */
const etapes = [
  {
    titre: 'Premier échange',
    resume: 'On parle de votre activité et de ce que le site doit vous apporter. <span class="cle">Gratuit et sans engagement.</span>',
  },
  {
    titre: 'Maquette',
    resume: 'Une première version à l’écran, ajustée jusqu’à ce qu’elle vous ressemble.',
  },
  {
    titre: 'Mise en ligne',
    resume: 'Nom de domaine, adresses mail, hébergement : rien à gérer de votre côté.',
  },
  {
    titre: 'Suivi',
    resume: 'Le site évolue avec votre activité, au fil de vos demandes.',
  },
];
---
<ol class="deroulement plein" role="list">
  {etapes.map((e, i) => (
    <li>
      <span class="etiquette" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
      <strong>{e.titre}</strong>
      <span set:html={e.resume} />
    </li>
  ))}
</ol>
