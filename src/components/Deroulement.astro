---
/*
 * « Comment ça se passe » : les quatre étapes, de l'écoute au suivi, pour
 * l'outil et le site ensemble, chacune en une phrase. Partagé par
 * l'accueil et /offre. Le résumé peut porter un mot clé (.cle).
 */
const etapes = [
  {
    titre: 'Premier échange',
    resume: 'Avant de proposer quoi que ce soit, je vous écoute&nbsp;: votre métier, votre façon de travailler, ce qui vous fait perdre du temps. <span class="cle">Gratuit et sans engagement.</span>',
  },
  {
    titre: 'Maquette',
    resume: 'Je vous propose l’outil qui répond à ce besoin, et vous le voyez à l’écran avant qu’il soit construit. On l’ajuste ensemble jusqu’à ce qu’il colle à votre façon de travailler.',
  },
  {
    titre: 'Mise en ligne',
    resume: 'Une première version simple de l’outil, et votre site s’il en faut un. Nom de domaine, adresses mail, hébergement&nbsp;: rien à gérer de votre côté.',
  },
  {
    titre: 'Suivi',
    resume: 'Selon votre formule, on fait le point ensemble et l’outil s’améliore avec ce qui vous manque à l’usage.',
  },
];
---
<ol class="deroulement plein" role="list">
  {etapes.map((e, i) => (
    <li>
      <span class="etiquette" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
      <strong>{e.titre}</strong>
      <span set:html={e.resume} />
    </li>
  ))}
</ol>
