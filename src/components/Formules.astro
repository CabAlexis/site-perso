---
/*
 * Les trois formules en cartes comparables : mêmes lignes, dans le même ordre,
 * d'une carte à l'autre. Partagé par l'accueil et /offre. Le niveau de titre
 * des cartes suit celui de la section qui les accueille. La formule
 * recommandée (champ `recommandee` dans offre.ts) est mise en avant, au centre
 * sur grand écran et en premier sur mobile ; les deux autres servent de repères.
 *
 * Variante « offre » : la création et la mise en service sont dites une fois
 * autour des cartes ; chaque carte liste en puces ce que paie le client
 * (`comprend` dans offre.ts, après le socle).
 * Elle ajoute le choix de la durée et du paiement : des boutons radio, et
 * chaque carte porte toutes les combinaisons, dont le CSS n'affiche que celle
 * qui est cochée (global.css, « Choix de la durée »). Aucun script : sans
 * :has(), la page reste lisible en 12 mois, paiement mensuel.
 */
import { formules, socle, socleCourt, conditions, durees, paiements, euros, prixAnnuel, tarifPour, montantAvance, moisPayes, ou, besoinPonctuel, optionsUnite } from '../data/offre';
import { prepublication } from '../data/publication.json';

interface Props {
  niveau?: 3 | 4;
  variante?: 'accueil' | 'offre';
}
const { niveau = 3, variante = 'accueil' } = Astro.props;
const accueil = variante === 'accueil';
const Titre = `h${niveau}`;

const libellesPaiement = { mensuel: 'Chaque mois', avance: 'D’avance' };
---
{!accueil && (
  <div class="choix plein">
    <fieldset>
      <legend class="etiquette">Durée d'engagement</legend>
      {durees.map((d) => (
        <label><input type="radio" name="duree" id={`duree-${d}`} value={d} checked={d === 12} /> {d}&nbsp;mois</label>
      ))}
    </fieldset>
    <fieldset>
      <legend class="etiquette">Paiement</legend>
      {paiements.map((p) => (
        <label><input type="radio" name="paiement" id={`paiement-${p}`} value={p} checked={p === 'mensuel'} /> {libellesPaiement[p]}</label>
      ))}
    </fieldset>
    <p class="choix-usage">{besoinPonctuel}</p>
  </div>
)}
<ul class:list={['formules plein', { 'formules-offre': !accueil }]} role="list">
  {formules.map((f) => (
    <li class:list={['formule', { 'formule-recommandee': f.recommandee }]}>
      {f.recommandee && <p class="formule-badge etiquette">Recommandée</p>}
      <Titre class="formule-nom" id={`formule-${f.id}`}>{f.nom}</Titre>
      <p class="formule-accroche">{f.accroche}</p>
      {accueil ? (
        <>
          <p class="formule-prix">
            <span class="formule-montant">{euros(f.prixMensuel)}</span>
            <span class="etiquette">HT par mois</span>
          </p>
          <p class="etiquette">ou {euros(prixAnnuel(f))} HT par an, un mois offert</p>
        </>
      ) : durees.map((d) => {
        const t = tarifPour(f, d);
        if (!t) {
          return (
            <div class="tarif" data-duree={d}>
              <p class="formule-absente">Pas de formule {d}&nbsp;mois</p>
              <p class="etiquette">{f.nom}&nbsp;: {ou(f.tarifs.map((x) => x.mois).reverse())}&nbsp;mois uniquement</p>
            </div>
          );
        }
        return (
          <div class="tarif" data-duree={d}>
            <div class="tarif" data-paiement="mensuel">
              <p class="formule-prix">
                <span class="formule-montant">{euros(t.prixMensuel)}</span>
                <span class="etiquette">HT par mois</span>
              </p>
              <p class="etiquette">{t.mois}&nbsp;mois, payé chaque mois</p>
            </div>
            <div class="tarif" data-paiement="avance">
              <p class="formule-prix">
                <span class="formule-montant">{euros(montantAvance(t))}</span>
                <span class="etiquette">HT pour {t.mois}&nbsp;mois</span>
              </p>
              <p class="etiquette">
                {t.mois}&nbsp;mois, payé d'avance&nbsp;: {moisPayes(t.mois) < t.mois
                  ? `${moisPayes(t.mois)}\u00a0mois payés, un mois offert`
                  : `${t.mois}\u00a0×\u00a0${euros(t.prixMensuel)}\u00a0HT`}
              </p>
            </div>
          </div>
        );
      })}
      <p class="formule-cible">{f.pourQui}</p>
      {!accueil && (
        <div class="formule-comprend">
          <p class="etiquette">Ce que comprend votre abonnement</p>
          <ul>
            {[socleCourt, ...f.comprend].map((c) => <li>{c}</li>)}
            {optionsUnite.formule === f.id && (
              <li class="formule-option">
                À l'unité&nbsp;: un point de {optionsUnite.point.duree} ({euros(optionsUnite.point.prix)}&nbsp;HT) ou une évolution
                ({euros(optionsUnite.evolution.prix)}&nbsp;HT)
              </li>
            )}
          </ul>
        </div>
      )}
      {accueil && <dl class="formule-lignes">
        <div>
          <dt class="etiquette">Création de votre site ou de votre bot</dt>
          <dd>Offerte, avec son espace d'administration. Mise en service : {euros(conditions.miseEnService)} HT, une seule fois.</dd>
        </div>
        <div>
          <dt class="etiquette">Compris</dt>
          <dd>{socle.join(', ').replace(/^./, (c) => c.toUpperCase())}</dd>
        </div>
        <div>
          <dt class="etiquette">Modifications</dt>
          <dd>{f.evolutions}</dd>
        </div>
        <div>
          <dt class="etiquette">Outil métier</dt>
          <dd>{f.outil}</dd>
        </div>
        <div>
          <dt class="etiquette">Point régulier</dt>
          <dd>{f.point}</dd>
        </div>
      </dl>}
    </li>
  ))}
</ul>
{accueil && (
  <p class="plein">
    Pour un bot, le tableau de bord est servi sur un sous-domaine (votrebot.cabalex.dev) ou sur
    votre propre domaine.
  </p>
  <p class="plein"><a href="/offre#formules">Durées et paiement d'avance</a></p>
)}
{prepublication && (
  <p class="etiquette ouverture">Ouverture des commandes à l'immatriculation de la société.</p>
)}
