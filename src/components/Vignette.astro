---
/*
 * Vignette d'une coupe pour l'accueil (cartes des projets et table de
 * l'en-tête) : la silhouette du mécanisme, sans texte (illisible à cette
 * taille). Purement décorative : le lien qui la contient porte le nom du
 * projet.
 */
import type { DonneesCoupe } from '../data/coupes';
import { pointe } from '../lib/pointe';

interface Props {
  id: string;
  coupe: DonneesCoupe;
  transition?: string;
}
const { id, coupe, transition } = Astro.props;
const hachures = `${id}-hachures`;

// Paquets de signal : un par lien, vitesse constante (≈ 90 unités/s), départs
// décalés pour que les schémas aient l'air de tourner sans clignoter en bloc.
const longueur = (pts: [number, number][]) =>
  pts.slice(1).reduce((t, [x, y], i) => t + Math.hypot(x - pts[i][0], y - pts[i][1]), 0);
const paquets = coupe.liens
  .filter((l) => l.points.length > 1)
  .map((l, i) => ({
    chemin: `M${l.points.map((p) => p.join(',')).join(' L')}`,
    duree: Math.max(0.9, longueur(l.points) / 90).toFixed(2),
    depart: ((i * 0.37) % 2.2).toFixed(2),
  }));
---
<svg class="vignette" style={transition ? `view-transition-name: ${transition}` : undefined} viewBox={`0 0 360 ${coupe.hauteur}`} aria-hidden="true" focusable="false">
  <defs>
    <pattern id={hachures} width="10" height="10" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <line x1="0" y1="0" x2="0" y2="10" class="coupe-hachure" />
    </pattern>
  </defs>
  {coupe.liens.map((lien) => (
    <g class="coupe-lien" data-etape={lien.etape ?? 0}>
      <polyline points={lien.points.map((p) => p.join(',')).join(' ')} class:list={['coupe-trace', { 'coupe-tirets': lien.tirets }]} />
      {lien.fleche !== false && <path d={pointe(lien.points, 14, 0.5)} class="coupe-pointe" />}
    </g>
  ))}
  {paquets.map((p) => (
    <circle r="9" class="vignette-paquet">
      <animateMotion path={p.chemin} dur={`${p.duree}s`} begin={`${p.depart}s`} repeatCount="indefinite" />
    </circle>
  ))}
  {coupe.noeuds.map((n) => (
    <g class:list={['coupe-noeud', n.ton && `coupe-${n.ton}`]} data-etape={n.etape ?? 0}>
      <rect x={n.x} y={n.y} width={n.l} height={n.h} class="coupe-fond" />
      {n.ton === 'contrainte' && <rect x={n.x} y={n.y} width={n.l} height={n.h} fill={`url(#${hachures})`} />}
      <rect x={n.x} y={n.y} width={n.l} height={n.h} class="coupe-cadre" />
      {/* Deux traits à la place du titre, pour garder la lecture « boîte étiquetée ». */}
      <line x1={n.x + 14} y1={n.y + 22} x2={n.x + Math.min(n.l - 14, 14 + n.titre.length * 7)} y2={n.y + 22} class="vignette-titre" />
    </g>
  ))}
</svg>
