---
import Base from './Base.astro';
import Todo from '../components/Todo.astro';
import { projetParSlug } from '../data/projets';

interface Props {
  slug: string;
}
const { slug } = Astro.props;
const { projet, numero, total, precedent, suivant } = projetParSlug(slug);
const consultables = projet.elements.filter((e) => e.url);
const declares = projet.elements.filter((e) => !e.url);
// Mots à trait d'union (« elles-mêmes », « plumes-jumelles.fr ») : jamais
// coupés au trait d'union en fin de ligne.
const morceaux = (texte: string) => texte.split(/(\S*\p{L}-\p{L}\S*)/u);
---
<Base titre={projet.titre} description={projet.description} type="article">
  <article class="projet">
    <header class="projet-tete grille">
      <p class="etiquette projet-repere">
        <span>{projet.rubrique === 'labo' && 'Labo · '}{String(numero).padStart(2, '0')} / {String(total).padStart(2, '0')}</span>
        <span class:list={['statut', `statut-${projet.statut.code}`]}>{projet.statut.libelle}</span>
      </p>
      <h1 class="affiche plein"><span style={`view-transition-name: titre-${projet.slug}`}>{projet.titre}</span></h1>
      <div class="chapeau"><slot name="contexte" /></div>
    </header>

    <section class="grille en-bref-bloc" aria-labelledby="en-bref">
      <div class="en-bref">
        <h2 id="en-bref" class="etiquette">En bref</h2>
        <dl>
          {projet.enBref.map((e) => (
            <div>
              <dt class="etiquette">{e.terme}</dt>
              <dd>{morceaux(e.texte).map((m, i) => (i % 2 ? <span class="insecable">{m}</span> : m))}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <div class="grille plus-loin-bloc">
      <h2 id="plus-loin" class="plus-loin">Pour aller plus loin</h2>
    </div>

    <div class="corps grille">
      <slot name="coupe" />
      <div class="prose">
        <slot />

        <section aria-labelledby="verifiable">
          <h2 id="verifiable" class="intertitre">Vérifiable</h2>
          {projet.sansPreuve && <p>{projet.sansPreuve.motif}</p>}
          {consultables.length > 0 && (
            <dl class="preuves">
              {consultables.map((e) => (
                <div>
                  <dt class="etiquette">{e.libelle}</dt>
                  <dd>
                    <a href={e.url}>{e.valeur}</a>
                    {e.note && <span class="etiquette preuve-note">{e.note}</span>}
                  </dd>
                </div>
              ))}
            </dl>
          )}
          {declares.length > 0 && (
            <>
              <p class="etiquette">Chiffres déclarés, dépôt privé :</p>
              <dl class="preuves preuves-declarees">
                {declares.map((e) => (
                  <div>
                    <dt class="etiquette">{e.libelle}</dt>
                    <dd>
                      {e.valeur && <span>{e.valeur}</span>}
                      {e.note && <span class="etiquette preuve-note">{e.note}</span>}
                      {e.todo && <Todo note={e.todo} />}
                    </dd>
                  </div>
                ))}
              </dl>
            </>
          )}
        </section>
      </div>
    </div>

    <nav class="suite grille" aria-label="Autres projets">
      <div class="plein suite-liens">
        {precedent ? <a href={`/${precedent.slug}`} rel="prev"><span class="etiquette">Précédent</span> {precedent.titre}</a> : <a href="/"><span class="etiquette">Retour</span> Accueil</a>}
        {suivant ? <a href={`/${suivant.slug}`} rel="next"><span class="etiquette">Suivant</span> {suivant.titre}</a> : <a href="/"><span class="etiquette">Retour</span> Accueil</a>}
      </div>
    </nav>
  </article>
</Base>
