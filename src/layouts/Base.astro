---
import '../styles/global.css';
import { prepublication } from '../data/publication.json';

interface Props {
  titre: string;
  description: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}
const { titre, description, type = 'website', noindex = false } = Astro.props;
// En sortie « fichier », le chemin vaut /nutrifollow.html ou /index.html : on
// retire l'extension pour retomber sur les URL publiques (/nutrifollow, /).
const chemin = Astro.url.pathname.replace(/(\/index)?\.html$/, '') || '/';
const canonique = new URL(chemin, Astro.site);
const titreComplet = titre === 'Alexis Cabillic' ? titre : `${titre} — Alexis Cabillic`;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonique} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/archivo-latin-wdth-normal.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#f2efe7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#13120f" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Alexis Cabillic" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Alexis Cabillic, développeur web à Pau. Je crée votre site, puis je m'en occupe." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="author" content="Alexis Cabillic" />
    {/* En prépublication, le site se partage par lien mais ne s'indexe pas. */}
    {(noindex || prepublication) && <meta name="robots" content="noindex, nofollow" />}
  </head>
  <body>
    <a class="saut" href="#contenu">Aller au contenu</a>
    <header class="bandeau grille">
      <nav class="plein" aria-label="Navigation principale">
        <a class="accueil" href="/">Alexis Cabillic</a>
        <a href="/offre">Offre</a>
        <a href="/#realisations">Réalisations</a>
        <a href="/#contact">Contact</a>
      </nav>
    </header>

    <main id="contenu">
      <slot />
    </main>

    <footer class="pied grille">
      <div class="plein">
        <p>Alexis Cabillic, développeur web à Pau. <a href="mailto:alexis@cabalex.dev">alexis@cabalex.dev</a></p>
        <ul>
          <li><a href="/mentions-legales">Mentions légales</a></li>
          <li><a href="https://github.com/CabAlexis/site-perso">Code source de ce site</a></li>
        </ul>
        <p>Ni cookie, ni mesure d'audience, ni ressource chargée chez un tiers : pas même les polices.</p>
      </div>
    </footer>
  </body>
</html>
